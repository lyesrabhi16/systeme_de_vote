ENV_MODE=production
ALLOWED_ORIGINS=*
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600


# DB Configuration
POSTGRES_USER=svs_user
POSTGRES_PASSWORD=svs_password
POSTGRES_DB=svs_db

# DB CONNECTION PARAMS
DB_DRIVER=postgresql+asyncpg
DB_HOST=svs-db
DB_USER=svs_user
DB_PASSWORD=svs_password
DB_PORT=5432
DB_NAME=svs_db

# REDIS Configuration
REDIS_HOST=svs-redis
REDIS_PORT=6379
REDIS_USER=svs-user
REDIS_PASSWORD=svs-pass
REDIS_DB=0

# OTP Configuration
OTP_EXPIRATION=300

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER_EMAIL=your_smtp_email@example.com
SMTP_USE_TLS=True
SMTP_STARTTLS=True

# Application Configuration
APP_NAME=SVS
FRONTEND_URL=http://localhost:5173

# Encryption Key
ENCRYPTION_KEY=your_encryption_key_32_bytes! # 32 url-safe base64-encoded bytes, generate in terminal with: openssl rand -base64 32