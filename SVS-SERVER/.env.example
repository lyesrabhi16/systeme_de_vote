# For running the API on your machine (make run-dev):  cp .env.example .env
# Everything is optional in development: missing secrets are made up for the process, and without SMTP_HOST the
# one-time passwords are written to the log instead of being emailed. A database and Redis are needed (docker compose -f ../docker-compose.demo.yml up db redis).

ENV_MODE=development

DB_DRIVER=postgresql+asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_USER=svs
DB_PASSWORD=svs-demo-db-password
DB_NAME=svs

REDIS_HOST=localhost
REDIS_PORT=6379

# the web client of `bun run dev`
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# to keep sessions, and the elections you make, across restarts, set both (see ../.env.example for how to make them):
# without ENCRYPTION_KEY the private key of each new election is encrypted with a key that is lost at the next restart,
# and the election can no longer be counted.
# JWT_SECRET_KEY=
# ENCRYPTION_KEY=
