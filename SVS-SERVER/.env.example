# For running the API on your machine (make run-dev):  cp .env.example .env
# What it needs around it (PostgreSQL, Redis, Mailpit), published on this machine:  docker compose -f ../docker-compose.dev.yml up -d   (make services)
# Everything else is optional in development: missing secrets are made up for the process.

ENV_MODE=development

DB_DRIVER=postgresql+asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_USER=svs
DB_PASSWORD=svs-demo-db-password
DB_NAME=svs

REDIS_HOST=localhost
REDIS_PORT=6379

# Mailpit (docker-compose.dev.yml): a mail server that keeps what it receives and delivers nothing. Every one-time password, receipt
# and reset link of the application arrives in its mailbox, http://localhost:8025. It takes mail without signing in, and without TLS.
# (Without SMTP_HOST the emails are written to the log instead.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_STARTTLS=False
SMTP_SENDER_EMAIL=svs@example.org

# the web client of `bun run dev`
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# to keep sessions, and the elections you make, across restarts, set both (see ../.env.example for how to make them):
# without ENCRYPTION_KEY the private key of each new election is encrypted with a key that is lost at the next restart,
# and the election can no longer be counted.
# JWT_SECRET_KEY=
# ENCRYPTION_KEY=
