HOST_URL=https://svs-server.localhost
ENV_MODE=production
ALLOWED_ORIGINS=*
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# DB Configuration
POSTGRES_USER=svs_user
POSTGRES_PASSWORD=svs_password
POSTGRES_DB=svs_db

# DB CONNECTION PARAMS
DB_DRIVER=postgresql+asyncpg
DB_HOST=localhost
DB_USER=svs_user
DB_PASSWORD=svs_password
DB_PORT=5432
DB_NAME=svs_db

# REDIS Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=svs-user
REDIS_PASSWORD=svs-pass
REDIS_DB=0

# OTP Configuration
OTP_EXPIRATION=300