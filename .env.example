# The configuration of the deployment (docker-compose.yml):  cp .env.example .env  and fill it in.
# Nothing here has a default on purpose: in production the application refuses to start with a missing or placeholder secret.
#
# A random secret:             openssl rand -hex 32
# A Fernet key:   openssl rand -base64 32 | tr '+/' '-_'

# the host name of the site (the certificate must be for it)
DOMAIN=svs-server.localhost
HOST_URL=https://svs-server.localhost
FRONTEND_URL=https://svs-server.localhost
# the origins of the web application, as the browser sees them. Never `*`: cookies are sent with the requests.
ALLOWED_ORIGINS=https://svs-server.localhost

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# signs the sessions (at least 32 characters)
JWT_SECRET_KEY=
# a Fernet key. It encrypts the private key of every election, which is kept in the database: LOSE IT AND THE ELECTIONS CAN NO LONGER
# BE COUNTED. Keep a copy somewhere that is not the server. Whoever has it and the database can read the votes.
ENCRYPTION_KEY=

# the one-time passwords and the reset links are sent by email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_USE_TLS=False
SMTP_STARTTLS=True
